{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradie-enquiry-desk",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "tradie-enquiry-desk", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "AI_MODE": "template", "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct", "AI_DAILY_LIMIT": "50" },
  "triggers": { "crons": ["17 3 * * *"] }
}
